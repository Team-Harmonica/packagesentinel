# ==============================================================================
# PackageSentinel Backend Configuration (.env)
# ==============================================================================

# Application Configuration
APP_NAME="PackageSentinel Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# Database Configuration
# Default SQLite async URL (zero-setup local development and unit tests):
DATABASE_URL="sqlite+aiosqlite:///./packagesentinel.db"

# Production PostgreSQL async URL:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/packagesentinel"
DB_ECHO=false

